FROM node:22-bookworm-slim AS build
RUN apt-get update && apt-get install -y --no-install-recommends python3 make g++ libvips-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json .npmrc ./
RUN npm ci --legacy-peer-deps --include=optional
COPY . .
ARG PUBLIC_URL
ARG CLIENT_URL
ENV NODE_ENV=production PUBLIC_URL=$PUBLIC_URL CLIENT_URL=$CLIENT_URL STRAPI_ADMIN_BACKEND_URL=$PUBLIC_URL STRAPI_TELEMETRY_DISABLED=true
# Backend source is CommonJS; the legacy tsconfig has no TypeScript inputs.
RUN rm -f tsconfig.json && npm run build && npm prune --omit=dev --legacy-peer-deps

FROM node:22-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends libvips42 dumb-init && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production HOST=0.0.0.0 PORT=1337 STRAPI_TELEMETRY_DISABLED=true
COPY --from=build --chown=node:node /app /app
RUN mkdir -p /app/public/uploads /app/.tmp /app/database/migrations /home/node/.config && chown node:node /app && chown -R node:node /app/public/uploads /app/.tmp /app/database /home/node
USER node
EXPOSE 1337
ENTRYPOINT ["dumb-init", "--"]
CMD ["npm", "start"]
