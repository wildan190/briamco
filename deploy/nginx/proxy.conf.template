resolver 127.0.0.11 valid=10s ipv6=off;
client_max_body_size 50m;
proxy_read_timeout 120s;
proxy_connect_timeout 10s;
proxy_http_version 1.1;
proxy_set_header Host $host;
proxy_set_header X-Real-IP $remote_addr;
proxy_set_header X-Forwarded-For $remote_addr;
proxy_set_header X-Forwarded-Proto $scheme;
proxy_set_header X-Forwarded-Host $host;
proxy_set_header Connection "";
location ~ ^/(admin|api|uploads|upload|content-manager|content-type-builder|i18n|users-permissions|email|documentation|review-workflows|releases|content-releases|_health)(/|$) {
  set $backend http://strapi:1337;
  proxy_pass $backend;
}
location / {
  set $web http://frontend:80;
  proxy_pass $web;
}
